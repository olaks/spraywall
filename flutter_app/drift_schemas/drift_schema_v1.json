    {
      "name": "walls",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"walls\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"grade_scale\" INTEGER NOT NULL, \"created_on\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "layouts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"layouts\" (\"id\" TEXT NOT NULL, \"wall_id\" TEXT NOT NULL REFERENCES walls (id), \"name\" TEXT NULL, \"started_on\" TEXT NOT NULL, \"ended_on\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wall_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wall_photos\" (\"id\" TEXT NOT NULL, \"layout_id\" TEXT NOT NULL REFERENCES layouts (id), \"sort_order\" INTEGER NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL, \"added_on\" TEXT NOT NULL, \"label\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "wall_photo_bytes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"wall_photo_bytes\" (\"photo_id\" TEXT NOT NULL REFERENCES wall_photos (id), \"data\" BLOB NOT NULL, \"thumb\" BLOB NOT NULL, PRIMARY KEY (\"photo_id\"));"
        }
      ]
    },
    {
      "name": "problems",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"problems\" (\"id\" TEXT NOT NULL, \"layout_id\" TEXT NOT NULL REFERENCES layouts (id), \"name\" TEXT NOT NULL, \"grade\" TEXT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"set_on\" TEXT NOT NULL, \"retired_on\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "marks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"marks\" (\"id\" TEXT NOT NULL, \"problem_id\" TEXT NOT NULL REFERENCES problems (id), \"photo_id\" TEXT NOT NULL REFERENCES wall_photos (id), \"role\" INTEGER NOT NULL, \"cx\" REAL NOT NULL, \"cy\" REAL NOT NULL, \"r\" REAL NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
